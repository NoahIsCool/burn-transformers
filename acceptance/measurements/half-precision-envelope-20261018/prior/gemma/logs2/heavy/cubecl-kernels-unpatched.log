#include <metal_stdlib>
using namespace metal;

struct alignas(8) bfloat_4 {
    bfloat i_0;
    bfloat i_1;
    bfloat i_2;
    bfloat i_3;
};

struct info_st {
    uint scalars_uint[2];uint static_meta[2];
};

/// Metal has a weird numerical behaviour with tanh for inputs over 43.0
inline bfloat safe_tanh_scalar(bfloat x) {
    if (x > 43.0) {
        return 1.0;
    } else {
        return tanh(x);
    }
}
inline bfloat_4 safe_tanh(bfloat_4 x) {
    return bfloat_4 { safe_tanh_scalar(x.i_0), safe_tanh_scalar(x.i_1), safe_tanh_scalar(x.i_2), safe_tanh_scalar(x.i_3) };
}

