#include <metal_stdlib>
using namespace metal;

struct alignas(8) half_4 {
    half i_0;
    half i_1;
    half i_2;
    half i_3;
};

struct info_st {
    uint scalars_uint[2];uint static_meta[2];
};

/// Metal has a weird numerical behaviour with tanh for inputs over 43.0
inline half safe_tanh_scalar(half x) {
    if (x > 43.0) {
        return 1.0;
    } else {
        return tanh(x);
    }
}
inline half_4 safe_tanh(half_4 x) {
    return half_4 { safe_tanh_scalar(x.i_0), safe_tanh_scalar(x.i_1), safe_tanh_scalar(x.i_2), safe_tanh_scalar(x.i_3) };
}

