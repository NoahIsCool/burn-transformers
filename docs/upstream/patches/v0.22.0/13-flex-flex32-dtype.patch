+/// The dtype Flex stores a float tensor of `dtype` in. `Flex32` is f32
+/// storage computed at F32 precision on the CPU, so Flex stores it as `F32`
+/// (as `float_random` already does); every Flex kernel dispatches on `F32`.
+fn storage_dtype(dtype: FloatDType) -> DType {
+    match dtype {
+        FloatDType::Flex32 => DType::F32,
+        other => other.into(),
+    }
+}
