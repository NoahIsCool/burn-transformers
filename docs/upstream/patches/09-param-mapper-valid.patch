+impl<T: Parameter + 'static> ParamMapper<T> {
+    /// Re-expresses both mappers on another parameter type `U`: each value is
+    /// converted to `T` with `into`, mapped, and converted back with `back`.
+    ///
+    /// Used to keep the mappers when a module moves between an autodiff backend
+    /// and its inner backend (`valid` and `from_inner`).
+    pub(crate) fn lift<U: Parameter + 'static>(
+        &self,
+        into: fn(U) -> T,
+        back: fn(T) -> U,
+    ) -> ParamMapper<U> {
+        let lift = |mapper: &Mapper<T>| -> Mapper<U> {
+            let mapper = mapper.clone();
+            new_mapper(move |value: U| back(mapper(into(value))))
+        };
+        ParamMapper {
+            load: self.load.as_ref().map(lift),
+            save: self.save.as_ref().map(lift),
+        }
+    }
+}
+
