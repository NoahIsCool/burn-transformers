+/// Whether `strategy` is known to compute wrong values for this packed,
+/// block-quantized right-hand side (cubek-matmul 0.2), by the width of its
+/// values: 2-bit operands on every routine (wrong even for one left-hand row),
+/// every operand on `GemvUnitPerpendicular`, sub-byte operands on
+/// `GemvPlaneParallel`, and sub-byte operands with more than one left-hand row
+/// on the unit routines, which `Strategy::Auto` falls back to when the
+/// cooperative-matrix routine declines the problem. Those launches dequantize
+/// the operand first until the kernels are fixed.
+fn packed_rhs_is_unreliable<R: CubeRuntime>(
+    strategy: &Strategy,
+    lhs: &CubeTensor<R>,
+    rhs: &CubeTensor<R>,
+) -> bool {
+    if rhs.qparams.is_none() || !matches!(rhs.scheme().level, QuantLevel::Block(_)) {
+        return false;
+    }
+    let bits = rhs.scheme().value.size_bits();
+    let shape = lhs.meta.shape();
+    let rows = shape[shape.num_dims() - 2];
+    match strategy {
+        _ if bits < 4 => true,
+        Strategy::GemvUnitPerpendicular(_) => true,
+        Strategy::GemvPlaneParallel(_) => bits < 8,
+        Strategy::Auto | Strategy::SimpleUnit(_) | Strategy::DoubleUnit(_) => bits < 8 && rows > 1,
+        _ => false,
+    }
+}
