+/// Whether `strategy` is known to compute wrong values for this packed,
+/// block-quantized right-hand side (cubek-matmul 0.2): every such operand on
+/// `GemvUnitPerpendicular`, 4-bit operands on `GemvPlaneParallel`, and 4-bit
+/// operands with more than one left-hand row on the unit routines, which
+/// `Strategy::Auto` falls back to on devices without cooperative matrices.
+/// Those launches dequantize the operand first until the kernels are fixed.
+fn packed_rhs_is_unreliable<R: CubeRuntime>(
+    strategy: &Strategy,
+    lhs: &CubeTensor<R>,
+    rhs: &CubeTensor<R>,
+) -> bool {
+    if rhs.qparams.is_none() || !matches!(rhs.scheme().level, QuantLevel::Block(_)) {
+        return false;
+    }
+    let four_bit = matches!(rhs.scheme().value, QuantValue::Q4S | QuantValue::Q4F);
+    let shape = lhs.meta.shape();
+    let rows = shape[shape.num_dims() - 2];
+    match strategy {
+        Strategy::GemvUnitPerpendicular(_) => true,
+        Strategy::GemvPlaneParallel(_) => four_bit,
+        Strategy::Auto | Strategy::SimpleUnit(_) | Strategy::DoubleUnit(_) => four_bit && rows > 1,
+        _ => false,
+    }
+}
