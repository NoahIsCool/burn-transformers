+/// Re-tags the `u8` output of a shared numeric kernel with the input's Boolean
+/// dtype. The generic `select`/`gather` kernels label their result `U8`, which
+/// later Boolean consumers (`cat`, `into_data().to_vec::<bool>()`) reject.
+fn retag_bool(tensor: FlexTensor, dtype: DType) -> FlexTensor {
+    debug_assert!(matches!(dtype, DType::Bool(_)), "retag_bool: {dtype:?}");
+    FlexTensor::from_arc(tensor.data_arc(), tensor.layout().clone(), dtype)
+}
