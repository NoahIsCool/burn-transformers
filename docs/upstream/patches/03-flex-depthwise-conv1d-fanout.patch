-                core::slice::from_raw_parts_mut(dst_ptr.ptr_add(bc * out_spatial), out_spatial)
-            };
-            plane_work(bc, out_plane);
-        });
+        let plane_work_size = (out_spatial * k_spatial).max(1);
+        let planes_per_task = crate::ops::PARALLEL_THRESHOLD.div_ceil(plane_work_size);
+        if batch_size * channels > planes_per_task {
+            let dst_ptr = crate::ops::SendMutPtr::new(output.as_mut_ptr());
+            (0..batch_size * channels)
+                .into_par_iter()
+                .with_min_len(planes_per_task)
+                .for_each(|bc| {
+                    // SAFETY: disjoint `[bc * out_spatial, (bc+1) * out_spatial)`
