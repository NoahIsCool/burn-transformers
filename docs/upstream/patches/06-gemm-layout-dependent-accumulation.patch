+static LAYOUT_INDEPENDENT_ACCUMULATION: AtomicBool = AtomicBool::new(false);
+
+/// Whether every product accumulates each output along `k` in the same order
+/// whatever the operands' strides (default `false`).
+#[inline]
+pub fn get_layout_independent_accumulation() -> bool {
+    LAYOUT_INDEPENDENT_ACCUMULATION.load(Ordering::Relaxed)
+}
+
+/// Requests (`true`) or releases layout-independent accumulation.
+///
+/// By default the kernel, and with it the order in which each output
+/// accumulates its `k` products, depends on the operands' strides: a product
+/// whose operands are both contiguous along `k` (`lhs_cs == 1 && rhs_rs == 1`,
+/// e.g. a row-major `A` times the transpose of a row-major `B`) accumulates
+/// partial dot products in SIMD lanes and reduces them horizontally (the
+/// small-product horizontal microkernel on x86, and the row-major gemv), the
+/// column-major gemv accumulates one sequential pass over `k`, and the packed
+/// microkernel accumulates `k` in cache blocks. These orders round
+/// differently, so results depend on memory layout. When enabled, the gemv
+/// and horizontal shortcuts are skipped and every product takes the packed
+/// microkernel path, so `A · B` is bitwise independent of how `A` and `B` are
+/// strided, at the cost of packing the operands of matrix-vector products.
+#[inline]
+pub fn set_layout_independent_accumulation(value: bool) {
+    LAYOUT_INDEPENDENT_ACCUMULATION.store(value, Ordering::Relaxed);
+}
