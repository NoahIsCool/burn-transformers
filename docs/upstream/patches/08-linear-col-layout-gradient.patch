diff --git a/crates/burn-core/src/module/param/base.rs b/crates/burn-core/src/module/param/base.rs
index 9397e19..83b6d5b 100644
--- a/crates/burn-core/src/module/param/base.rs
+++ b/crates/burn-core/src/module/param/base.rs
@@ -350,9 +350,12 @@ impl<T: Parameter> Param<T> {
             Some(value) => {
                 let prev = value.init.clone();
 
-                value.init = new_init_fn(move |a, b| {
-                    let tensor = prev(a, b);
-                    func(tensor)
+                // Map the untracked initial value, then apply the gradient policy, so the
+                // parameter is the leaf itself rather than a node derived from it (whose
+                // gradient a backward pass would consume instead of keeping it).
+                value.init = new_init_fn(move |device, require_grad| {
+                    let tensor = prev(device, false);
+                    func(tensor).set_require_grad(require_grad)
                 });
                 core::mem::drop(init);
                 self
