diff --git a/crates/burn-cubecl/src/kernel/attention/base.rs b/crates/burn-cubecl/src/kernel/attention/base.rs
index bf592b4..5ba8018 100644
--- a/crates/burn-cubecl/src/kernel/attention/base.rs
+++ b/crates/burn-cubecl/src/kernel/attention/base.rs
@@ -96,6 +96,18 @@ pub fn flash_attention<R: CubeRuntime>(
     options: AttentionModuleOptions,
     strategy: launch::Strategy,
 ) -> Result<CubeTensor<R>, AttentionSetupError> {
+    // The cubek flash kernels mask `row < col`, i.e. they align a causal mask
+    // top-left. Burn's `attention` contract (and `attention_fallback`) aligns
+    // it bottom-right: query row `i` of `seq_q` sits at key position
+    // `i + seq_kv - seq_q`. Both agree only for square problems, so decline
+    // the others; autotuning then keeps the fallback, and an explicit flash
+    // strategy reports the mismatch instead of returning top-left results.
+    if options.is_causal && query.meta.shape[2] != key.meta.shape[2] {
+        return Err(AttentionSetupError::InvalidConfig(Box::new(
+            "flash attention aligns causal masks top-left; causal attention with seq_q != seq_kv requires the bottom-right fallback",
+        )));
+    }
+
     let client = query.client.clone();
     let out = init_attention_output(&query, &value);
 
diff --git a/crates/burn-cubecl/src/ops/module.rs b/crates/burn-cubecl/src/ops/module.rs
